{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/today/index",
      "style": {
        "navigationStyle": "custom",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "light",
        "backgroundColor": "#4a6b7f",
        "backgroundColorTop": "#4a6b7f",
        "backgroundColorBottom": "#ffffff",
        "navigationBarTitleText": "家庭菜单",
        "navigationBarBackgroundColor": "#4a6b7f",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/dishes/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "菜谱",
        "navigationBarBackgroundColor": "#4a6b7f",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/shopping/index",
      "style": {
        "navigationStyle": "custom",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "light",
        "backgroundColor": "#4a6b7f",
        "backgroundColorTop": "#4a6b7f",
        "backgroundColorBottom": "#ffffff",
        "navigationBarTitleText": "买菜",
        "navigationBarBackgroundColor": "#4a6b7f",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/mine/index",
      "style": {
        "navigationStyle": "custom",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "light",
        "backgroundColor": "#4a6b7f",
        "backgroundColorTop": "#4a6b7f",
        "backgroundColorBottom": "#ffffff",
        "navigationBarTitleText": "我的",
        "navigationBarBackgroundColor": "#4a6b7f",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/order/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "点菜",
        "navigationBarBackgroundColor": "#4a6b7f",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/family/index",
      "style": {
        "navigationBarTitleText": "家庭管理"
      }
    },
    {
      "path": "pages/categories/index",
      "style": {
        "navigationBarTitleText": "编辑分类"
      }
    },
    {
      "path": "pages/serve/index",
      "style": {
        "navigationBarTitleText": "记下这餐"
      }
    },
    {
      "path": "pages/diary/index",
      "style": {
        "navigationBarTitleText": "饮食日记"
      }
    },
    {
      "path": "pages/dish/detail",
      "style": {
        "navigationBarTitleText": "菜品"
      }
    },
    {
      "path": "pages/dish/edit",
      "style": {
        "navigationBarTitleText": "编辑菜品"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "家庭菜单",
    "navigationBarBackgroundColor": "#F5F7F8",
    "backgroundColor": "#F5F7F8"
  },
  "tabBar": {
    "custom": true,
    "color": "#69777A",
    "selectedColor": "#304D60",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/today/index",
        "text": "这顿",
        "iconPath": "static/tabbar/today.png",
        "selectedIconPath": "static/tabbar/today-active.png"
      },
      {
        "pagePath": "pages/dishes/index",
        "text": "菜谱",
        "iconPath": "static/tabbar/dishes.png",
        "selectedIconPath": "static/tabbar/dishes-active.png"
      },
      {
        "pagePath": "pages/shopping/index",
        "text": "买菜",
        "iconPath": "static/tabbar/shopping.png",
        "selectedIconPath": "static/tabbar/shopping-active.png"
      },
      {
        "pagePath": "pages/mine/index",
        "text": "我的",
        "iconPath": "static/tabbar/mine.png",
        "selectedIconPath": "static/tabbar/mine-active.png"
      }
    ]
  }
}
