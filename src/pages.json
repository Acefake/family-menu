{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    { "path": "pages/today/index", "style": { "navigationBarTitleText": "今日菜单" } },
    { "path": "pages/order/index", "style": { "navigationBarTitleText": "点菜" } },
    { "path": "pages/dishes/index", "style": { "navigationBarTitleText": "菜谱" } },
    { "path": "pages/mine/index", "style": { "navigationBarTitleText": "我的" } },
    { "path": "pages/dish/detail", "style": { "navigationBarTitleText": "菜品" } },
    { "path": "pages/dish/edit", "style": { "navigationBarTitleText": "编辑菜品" } },
    { "path": "pages/shopping/index", "style": { "navigationBarTitleText": "采购清单" } }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "家庭菜单",
    "navigationBarBackgroundColor": "#FBF7F2",
    "backgroundColor": "#FBF7F2"
  },
  "tabBar": {
    "color": "#6E625A",
    "selectedColor": "#C8431B",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/today/index",
        "text": "今日",
        "iconPath": "static/tabbar/today.png",
        "selectedIconPath": "static/tabbar/today-active.png"
      },
      {
        "pagePath": "pages/order/index",
        "text": "点菜",
        "iconPath": "static/tabbar/order.png",
        "selectedIconPath": "static/tabbar/order-active.png"
      },
      {
        "pagePath": "pages/dishes/index",
        "text": "菜谱",
        "iconPath": "static/tabbar/dishes.png",
        "selectedIconPath": "static/tabbar/dishes-active.png"
      },
      {
        "pagePath": "pages/mine/index",
        "text": "我的",
        "iconPath": "static/tabbar/mine.png",
        "selectedIconPath": "static/tabbar/mine-active.png"
      }
    ]
  }
}
