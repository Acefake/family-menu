/* 悬浮胶囊 tab 栏：磨砂玻璃底，选中项一颗圆润的高亮胶囊 */
.dock {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  /* 底边离屏幕底部：10px + 70% 的安全区，让开 Home 指示条 */
  padding: 0 20px calc(10px + env(safe-area-inset-bottom) * 0.7);
  pointer-events: none;
}

.pill {
  display: flex;
  align-items: center;
  height: 68px;
  padding: 6px;
  box-sizing: border-box;
  pointer-events: auto;
  background: rgba(255, 255, 255, 0.74);
  border: 1px solid rgba(255, 255, 255, 0.85);
  border-radius: 34px;
  box-shadow:
    0 10px 30px rgba(38, 63, 79, 0.16),
    0 1px 3px rgba(38, 63, 79, 0.08);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  backdrop-filter: blur(24px) saturate(180%);
}

.item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  border-radius: 28px;
  transition: background 0.25s ease;
}

.item.on {
  background: rgba(48, 77, 96, 0.11);
}

.icon {
  width: 26px;
  height: 26px;
}

.label {
  margin-top: 2px;
  color: #69777a;
  font-size: 10px;
  line-height: 12px;
}

.item.on .label {
  color: #304d60;
  font-weight: 600;
}

.item {
  position: relative;
}

.badge {
  position: absolute;
  top: 6px;
  left: 50%;
  min-width: 16px;
  height: 16px;
  margin-left: 6px;
  padding: 0 4px;
  box-sizing: border-box;
  color: #fff;
  font-size: 10px;
  line-height: 16px;
  text-align: center;
  background: #d9534f;
  border-radius: 8px;
}
