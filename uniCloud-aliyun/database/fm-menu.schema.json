{
  "bsonType": "object",
  "description": "某天某一顿的菜单（客户端无权限，只经由云对象 menu-co 访问）",
  "required": ["familyId", "date", "meal"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "familyId": {
      "bsonType": "string",
      "description": "所属家庭"
    },
    "date": {
      "bsonType": "string",
      "description": "YYYY-MM-DD"
    },
    "meal": {
      "bsonType": "string",
      "enum": ["breakfast", "lunch", "dinner"]
    },
    "items": {
      "bsonType": "array",
      "items": {
        "bsonType": "object",
        "properties": {
          "dishId": {
            "bsonType": "string",
            "description": "菜品 ID"
          },
          "orderedBy": {
            "bsonType": "string",
            "description": "点菜人 uid"
          },
          "done": {
            "bsonType": "bool"
          }
        }
      }
    },
    "bought": {
      "bsonType": "object",
      "description": "采购清单勾选状态，key 为食材名"
    }
  }
}
