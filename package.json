{
  "name": "family-menu",
  "version": "0.1.0",
  "private": true,
  "description": "家庭菜单微信小程序（uniapp + uniCloud）",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "uni -p mp-weixin",
    "dev:h5": "uni",
    "build": "uni build -p mp-weixin",
    "build:h5": "uni build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && prettier --check ."
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5030420261029002",
    "@dcloudio/uni-components": "3.0.0-5030420261029002",
    "@dcloudio/uni-h5": "3.0.0-5030420261029002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5030420261029002",
    "pinia": "2.1.7",
    "vue": "3.4.21",
    "vue-i18n": "^9.1.9",
    "wot-design-uni": "^1.0.0"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-5030420261029002",
    "@dcloudio/uni-cli-shared": "3.0.0-5030420261029002",
    "@dcloudio/uni-stacktracey": "3.0.0-5030420261029002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5030420261029002",
    "@eslint/js": "^9.39.5",
    "@vue/runtime-core": "3.4.21",
    "@vue/tsconfig": "^0.1.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "sass": "1.77.8",
    "typescript": "^4.9.4",
    "typescript-eslint": "^8.72.2",
    "vite": "5.2.8",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^1.0.24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  }
}
