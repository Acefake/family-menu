  {
    "key": "tomato-eggs",
    "name": "番茄炒蛋",
    "category": "veg",
    "tags": ["快手菜"],
    "minutes": 15,
    "ingredients": [
      { "name": "番茄", "qty": "2个" },
      { "name": "鸡蛋", "qty": "3个" },
      { "name": "食用油", "qty": "1汤匙" },
      { "name": "盐", "qty": "少许" }
    ],
    "steps": [
      "番茄切块，鸡蛋加少许盐打散。",
      "热锅倒入一半油，倒入蛋液炒至刚凝固，盛出。",
      "用剩下的油把番茄炒软出汁，倒回鸡蛋翻匀，加盐调味。"
    ]
  },
  {
    "key": "pepper-pork",
    "name": "青椒肉丝",
    "category": "meat",
    "tags": ["下饭菜"],
    "minutes": 20,
    "ingredients": [
      { "name": "猪里脊", "qty": "200克" },
      { "name": "青椒", "qty": "2个" },
      { "name": "生抽", "qty": "1汤匙" },
      { "name": "淀粉", "qty": "1茶匙" },
      { "name": "食用油", "qty": "1汤匙" }
    ],
    "steps": [
      "里脊和青椒切丝。肉丝用一半生抽、淀粉和少许水抓匀，腌10分钟。",
      "热锅倒油，把肉丝滑炒至变色后盛出。",
      "用锅里余油将青椒炒至断生，倒回肉丝和剩余生抽，炒至肉丝熟透。"
    ]
  },
  {
    "key": "garlic-bok-choy",
    "name": "蒜蓉小青菜",
    "category": "veg",
    "tags": ["清淡", "快手菜"],
    "minutes": 10,
    "ingredients": [
      { "name": "小青菜", "qty": "300克" },
      { "name": "大蒜", "qty": "3瓣" },
      { "name": "食用油", "qty": "1汤匙" },
      { "name": "盐", "qty": "少许" }
    ],
    "steps": [
      "小青菜纵切对半，洗净沥干。大蒜切末。",
      "热锅下油，小火炒香蒜末。",
      "转大火倒入小青菜，翻炒至菜梗断生，加盐拌匀即可。"
    ]
  },
  {
    "key": "winter-melon-soup",
    "name": "冬瓜排骨汤",
    "category": "soup",
    "tags": ["清淡"],
    "minutes": 65,
    "ingredients": [
      { "name": "猪排骨", "qty": "400克" },
      { "name": "冬瓜", "qty": "400克" },
      { "name": "生姜", "qty": "3片" },
      { "name": "小葱", "qty": "1根" },
      { "name": "盐", "qty": "少许" }
    ],
    "steps": [
      "排骨冷水下锅，煮开后撇去浮沫，捞出冲洗。冬瓜去皮去瓤后切块。",
      "排骨和姜片加入约1.5升清水，煮开后转小火炖45分钟。",
      "加冬瓜炖至透明软嫩，放盐调味，出锅前撒葱花。"
    ]
  },
  {
    "key": "mushroom-chicken",
    "name": "香菇滑鸡",
    "category": "meat",
    "tags": ["下饭菜"],
    "minutes": 25,
    "ingredients": [
      { "name": "去骨鸡腿肉", "qty": "300克" },
      { "name": "鲜香菇", "qty": "6朵" },
      { "name": "生抽", "qty": "1汤匙" },
      { "name": "淀粉", "qty": "1茶匙" },
      { "name": "小葱", "qty": "1根" },
      { "name": "食用油", "qty": "1汤匙" }
    ],
    "steps": [
      "鸡腿肉切片，用生抽、淀粉和少许水抓匀，腌10分钟。香菇切片，小葱切段。",
      "热锅下油，滑炒鸡肉至表面变色，加入香菇炒香。",
      "加2汤匙水，盖盖焖至鸡肉熟透，再开盖收汁，撒葱段翻匀。"
    ]
  },
  {
    "key": "egg-fried-rice",
    "name": "鸡蛋炒饭",
    "category": "staple",
    "tags": ["快手菜"],
    "minutes": 15,
    "ingredients": [
      { "name": "熟米饭", "qty": "2碗" },
      { "name": "鸡蛋", "qty": "2个" },
      { "name": "胡萝卜", "qty": "半根" },
      { "name": "小葱", "qty": "1根" },
      { "name": "食用油", "qty": "1汤匙" },
      { "name": "盐", "qty": "少许" }
    ],
    "steps": [
      "米饭拨散，胡萝卜切小丁，小葱切成葱花，鸡蛋打散。",
      "热锅倒油，倒入蛋液炒散，加入胡萝卜丁炒熟。",
      "倒入米饭翻炒至颗粒松散、热透，拌入盐和葱花。"
    ]
  }
]
