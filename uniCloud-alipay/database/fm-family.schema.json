{
  "bsonType": "object",
  "description": "家庭（客户端无权限，只经由云对象 menu-co 访问）",
  "required": ["name", "inviteCode"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "name": {
      "bsonType": "string",
      "description": "家庭名",
      "maxLength": 20
    },
    "inviteCode": {
      "bsonType": "string",
      "description": "4 位邀请码",
      "maxLength": 8
    },
    "ownerId": {
      "bsonType": "string",
      "description": "创建者 uid"
    },
    "createdAt": {
      "bsonType": "timestamp",
      "description": "创建时间"
    }
  }
}
