{
  "bsonType": "object",
  "description": "用户（客户端无权限，只经由云对象 menu-co 访问）",
  "required": ["openid"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "openid": {
      "bsonType": "string",
      "description": "微信 openid"
    },
    "nickname": {
      "bsonType": "string",
      "description": "家里的称呼",
      "maxLength": 12
    },
    "familyId": {
      "bsonType": "string",
      "description": "所属家庭 ID，空表示未加入"
    },
    "createdAt": {
      "bsonType": "timestamp",
      "description": "注册时间"
    }
  }
}
